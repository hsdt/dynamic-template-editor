{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@hsdt/vue-template-editor": [
        "projects/template-editor/dist/index"
      ],
      "@hsdt/vue-template-editor/types": [
        "projects/template-editor/src/types/index.ts"
      ],
      "@hsdt/vue-template-editor/utils": [
        "projects/template-editor/src/utils/index.ts"
      ]
    }
  }
}
