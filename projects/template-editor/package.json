{
  "name": "@hsdt/vue-template-editor",
  "version": "0.1.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsdt/dynamic-template-editor.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "watch": "vite build --watch",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build && vue-tsc -p tsconfig.app.json --declaration --emitDeclarationOnly --outDir dist --declarationMap false",
    "preview": "vite preview",
    "capture:template": "node ./scripts/capture-template-artifacts.mjs"
  },
  "dependencies": {
    "@imengyu/vue3-context-menu": "^1.5.2",
    "@vue/compiler-core": "^3.5.22",
    "@vue/compiler-dom": "^3.5.22",
    "autosize": "^6.0.1",
    "bootstrap": "^5.3.8",
    "codemirror-editor-vue3": "^2.8.0",
    "font-awesome": "^4.7.0",
    "js-beautify": "^1.15.4",
    "moment": "^2.30.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/js-beautify": "^1.14.3",
    "@types/prettier": "^2.7.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "playwright": "^1.54.2",
    "typescript": "~5.8.2",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vue-tsc": "^3.1.3"
  }
}
